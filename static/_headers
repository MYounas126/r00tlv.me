/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://r00tlv.me; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Browsers only apply an XSLT stylesheet when it is served as XML
/rss-style.xsl
  Content-Type: text/xsl; charset=utf-8
  Cache-Control: public, max-age=86400

# Search Console lists twelve rss.xml files and the favicon under "Crawled -
# currently not indexed". That verdict is correct, since a feed is not a page,
# but Google spent crawl budget reaching them between 31 Aug and 10 Sep while
# six real posts went uncrawled for over a month. Telling it plainly that the
# feeds are not index candidates takes them out of that bucket and stops them
# competing for attention on a domain with very little budget to spend.
# noindex only, never nofollow: the feed's links to the posts should still be
# followed, and on this site that is an extra discovery path to them.
/*.xml
  X-Robots-Tag: noindex

/favicon.ico
  X-Robots-Tag: noindex

/*.webmanifest
  X-Robots-Tag: noindex

# The sitemap must stay crawlable and is harmless to leave unflagged, but an
# explicit allow keeps the rule above from ever being read as covering it.
/sitemap.xml
  ! X-Robots-Tag

# Fingerprinted assets never change under the same name
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800
