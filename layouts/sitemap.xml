{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Pages }}
  {{- /* Hugo's built-in template honours `sitemap.disable` in front matter. This override
         has to repeat that check explicitly, otherwise a page like /search/ that is
         deliberately noindex reappears here and the two signals contradict each other. */}}
  {{- /* Keep the sitemap and the robots tag saying the same thing: a term page
         with a single post is noindex (see _partials/head.html), so it must not
         be advertised here either. */}}
  {{- if and (not .Sitemap.Disable) (not (and (eq .Kind "term") (lt (len .Pages) 2))) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
    {{- /* Every URL carried equal weight, and the result shows in Search Console:
           eleven taxonomy pages are indexed against three posts, while six posts
           have never been crawled. Priority is a weak hint rather than an
           instruction, but it costs nothing to stop telling Google that
           /tags/xss/ is worth as much as a 2,800-word post. */}}
    {{- $pri := cond (eq .Kind "page") 1.0 (cond (in (slice "home" "section") .Kind) 0.7 0.3) }}
    {{- $freq := cond (eq .Kind "page") "monthly" "weekly" }}
    <changefreq>{{ with .Sitemap.ChangeFreq }}{{ . }}{{ else }}{{ $freq }}{{ end }}</changefreq>
    <priority>{{ $pri }}</priority>
  </url>
  {{- end }}
  {{- end }}
  {{- /* Interactive pages live in static/ because they are self-contained single files with no
         dependency on the theme. Hugo never sees them as Pages, so they would be absent from the
         sitemap entirely unless listed here. Add a new entry whenever a lab or anatomy page is
         added, and the CI build asserts the file behind each of these actually exists. */}}
  {{- range site.Params.staticPages }}
  <url>
    <loc>{{ printf "%s%s" site.BaseURL (strings.TrimPrefix "/" .url) }}</loc>
    <changefreq>monthly</changefreq>
    <priority>{{ .priority }}</priority>
  </url>
  {{- end }}
</urlset>
